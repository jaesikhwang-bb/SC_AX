# Every classification request calls this GenOS OpenAI-compatible model.
GENOS_URL=https://genos.genon.ai
GENOS_SERVING_ID=850
GENOS_MODEL=qwen/qwen3.7-flash
GENOS_BEARER_TOKEN=ffabf121d76e4b59aefb524b83cce180

# Omit to use prompts/intent-classification/active.yaml active_version.
INTENT_PROMPT_VERSION=v1

# Chat history
CHAT_HISTORY_BACKEND=redis
# CHAT_HISTORY_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
REDIS_HISTORY_KEY_PREFIX=chat:history
CHAT_HISTORY_LIMIT=10

# 대화 이력과 HITL 대기 상태는 같은 일반 Redis 서버를 사용합니다.
PROJECT_CODE=acqsc
REDIS_URL=redis://localhost:6379/0
REDIS_DEDUPE_TTL_SECONDS=86400
HITL_STATE_BACKEND=redis
REDIS_HITL_KEY_PREFIX=hitl:state
REDIS_HITL_TTL_SECONDS=3600

# guide.ipynb와 동일한 GenOS Gateway MCP 실제 호출 설정
MCP_BACKEND=http
MCP_ID=475
MCP_BEARER_TOKEN=44fa3a0ee9b34d35a1daed01a2a2944d
MCP_TIMEOUT_SECONDS=30
